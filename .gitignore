# Dependencies, build output, and local caches.
node_modules/
dist/
coverage/
.astro/
.vite/
.pnpm-store/
.wrangler/
*.tsbuildinfo
.foliohaven/
.alfred/
test-results/
playwright-report/
__pycache__/
*.pyc

# Local logs and temporary files.
*.log
*.pid
.devcontainer-write-check.*
.DS_Store
Thumbs.db
*.swp
