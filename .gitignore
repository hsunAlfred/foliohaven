# Local environment files and credentials. Keep safe example files trackable.
.env
.env.*
!.env.example
!/.env.cloudflare.example
/cloudflare.config.json
*.pem
*.key
.ssh/

# Machine-specific editor state; shared settings remain trackable.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
