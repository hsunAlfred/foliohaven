# 發行版本，必須與根目錄 package.json 的 version 相同。
RELEASE_VERSION=1.1.0
# 本機映像名稱，不含版本標籤；不同工作副本可使用不同名稱。
# 映像包含編輯、建置與測試工具；掛載的專案檔案保存在主機。
RELEASE_IMAGE_NAME=foliohaven

# Linux 主機檔案擁有者，以 id -u / id -g 查詢，兩個值皆不可為 0。
# Docker Desktop 使用者通常可維持預設值。
LOCAL_UID=1000
LOCAL_GID=1000

# 主機瀏覽器連接埠，只發布在 127.0.0.1；容器內連接埠固定。
# 修改前先停止既有服務。
SITE_PORT=4321
STUDIO_PORT=5173
PREVIEW_PORT=4322
